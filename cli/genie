#!/usr/bin/env python3
"""genie — Orange Genie in your terminal. No Claude Code required.

    genie                                                 open a session and just talk
    genie "why is my launchd job not finding yt-dlp?"     one-shot question
    genie recall <words>                                  search the chain directly
    genie providers                                       which brain you have, and where tokens go
    genie serve                                           run the OpenAI-compatible endpoint (Hermes, Cursor, …)
    genie login "<name>"                                  claim your identity on the Mesh (do this first)
    genie whoami                                          your identity on the Mesh
    genie update                                          re-fetch the parts from the public repo

WHAT THIS IS
    A thin command over three pieces that already exist and already work on their own:
      brain.py   four providers (ollama / pool / groq / anthropic), degrades until one answers
      chain.sh   read + write the OrangeGenie Mesh over plain HTTPS
      canon.md   who Genie is
    This file is the glue and nothing more. It deliberately implements no brain and no chain
    client — those live in the plugin repo and are shared with every other surface, so a fix
    there reaches here for free.

WHY grounded() AND NOT brain()
    grounded() feeds the model the chain's cheat sheet for your question first, and reports
    which proven skills it used. That is the whole product: a commodity open-weight model that
    answers like it has lived through everything the network already solved. An ungrounded
    answer is just a chatbot.

YOUR TOKENS
    Every answer prints which provider served it and whether the text left your machine.
    Only `ollama` is genuinely private — it runs on your own hardware and nothing leaves.

RECREATE: install.sh next to this file. Needs python3 + curl. No pip, no account, no key from us.
"""
import os, sys, shutil, subprocess, textwrap

# realpath, NOT abspath: install.sh symlinks ~/.local/bin/genie -> ~/.orangegenie/cli/genie,
# and abspath does not resolve symlinks. Run through the symlink, HERE became ~/.local/bin
# and every sibling file (chain.sh, canon.md, genie_llm.py) was "missing" — while `import
# brain` still worked, because Python resolves sys.path[0] separately. That split is what
# made it look fine: asking worked, chain commands did not.
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)                     # brain.py sits beside this file
CHAIN = os.path.join(HERE, "chain.sh")
CANON = os.path.join(HERE, "canon.md")
REPO_RAW = "https://raw.githubusercontent.com/orange-genie/genie-plugin/main"

BOLD, DIM, ORANGE, RESET = "\033[1m", "\033[2m", "\033[38;5;208m", "\033[0m"
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    BOLD = DIM = ORANGE = RESET = ""


def canon():
    """The system prompt. Without it this is a generic model with a chain lookup bolted on."""
    try:
        with open(CANON) as f:
            return f.read()
    except OSError:
        return "You are Genie: terse, useful, lead with the answer, end on a statement."


def die(msg, code=1):
    print(f"{msg}", file=sys.stderr)
    sys.exit(code)


def no_brain_help(brief=False):
    """The ONE place that explains how to get a brain.

    It used to be three: this function, brain.py's provider table, and install.sh's closing
    banner all printed their own ollama instructions, so a new user's first screen showed the
    same three commands three times and buried the one action that mattered. The table now
    reports state only, install.sh defers to the installer prompt, and this is the single voice.

    brief=True is the one-liner used when the user is mid-flow and just needs the pointer.
    """
    if brief:
        print(f"{DIM}No brain reachable. Set one up: genie providers{RESET}")
        return
    mac = sys.platform == "darwin"
    get = "brew install ollama" if (mac and shutil.which("brew")) else \
          "curl -fsSL https://ollama.com/install.sh | sh"
    print(textwrap.dedent(f"""
        {BOLD}No brain is reachable.{RESET} The free and private option runs on this machine:

          {get}
          ollama serve &
          ollama pull hermes3          {DIM}# about 4.7 GB{RESET}

        {DIM}Nothing you type leaves your computer on that setting.{RESET}

        Already have a Groq key?  export GROQ_API_KEY=...
        Using a peer's machine?   export GENIE_POOL_URL=http://<peer>:11434/v1
    """).rstrip())


def cmd_ask(question):
    try:
        import brain
    except ImportError:
        die("✗ brain.py is missing next to this script. Run: genie update")

    if not any(brain.available().values()):
        no_brain_help()
        sys.exit(1)

    txt, info = brain.grounded(canon(), question, k=4)
    if txt is None:
        die(f"✗ no brain answered — {info.get('why', 'unknown')}")

    where = {"CLOUD": "left your machine", "PEER": "went to a peer", "NONE": "never left your machine"}
    print(f"\n{txt}\n")
    print(f"{DIM}[{info.get('provider')} · {info.get('model')} · "
          f"{where.get(info.get('egress'), '?')}]{RESET}")
    if info.get("skills"):
        print(f"{DIM}[grounded on: {', '.join(info['skills'])}]{RESET}")
    else:
        print(f"{DIM}[not grounded — the chain had nothing on this yet]{RESET}")


def _chain_runner():
    """Pick how to reach the chain: bash where there IS bash, pure Python where there isn't.

    Native Windows has no bash, so `bash chain.sh` failed there — which meant a Windows user
    could install the CLI and ask questions (brain.py is stdlib-only) but could never claim a
    name or search the chain. WSL was the workaround and it is not a product.

    bash stays FIRST on every machine that has it: chain.sh is the proven implementation and
    the Stop hook depends on it, so Mac/Linux behaviour is unchanged. chain.py is a second
    client of the same HTTP API for the machines bash never reaches.
    """
    if shutil.which("bash") and os.path.exists(CHAIN):
        return ["bash", CHAIN]
    py = os.path.join(HERE, "chain.py")
    if os.path.exists(py):
        return [sys.executable, py]
    return None


def cmd_chain(args):
    runner = _chain_runner()
    if not runner:
        die("✗ chain.sh / chain.py are missing next to this script. Run: genie update")
    sys.exit(subprocess.call(runner + args))


def cmd_providers():
    try:
        import brain
    except ImportError:
        die("✗ brain.py is missing next to this script. Run: genie update")
    brain._providers_table()
    if not any(brain.available().values()):
        no_brain_help()


def cmd_serve(args):
    """Run the local OpenAI-compatible endpoint, so ANY existing agent can use the chain.

    This is the integration door. Hermes Agent, Cursor, Continue, LangChain, the OpenAI SDKs —
    they all already speak this protocol, so pointing one at http://localhost:8756/v1 puts the
    chain underneath a tool the person already uses. Nothing to adopt, one line to change.

    Defaults are set for SELF-HOSTED use, and they matter:
      GENIE_OPEN=1   no API key. Correct ONLY because this binds to your own machine — the key
                     lock upstream exists to stop strangers spending someone else's budget, not
                     to gate you on your own box. Never set this on a public instance.
      GENIE_UPSTREAM if you set it to your own ollama, nothing leaves your machine and you still
                     get the identical chain grounding. If you don't, it forwards to Groq's
                     cloud — fast and nearly free, but NOT private. That choice is yours to
                     make knowingly, so `serve` prints which one is in force.
    """
    llm = os.path.join(HERE, "genie_llm.py")
    if not os.path.exists(llm):
        die("✗ genie_llm.py is missing next to this script. Run: genie update")
    env = dict(os.environ)
    env.setdefault("GENIE_OPEN", "1")
    upstream = env.get("GENIE_UPSTREAM", "https://api.groq.com/openai/v1")
    private = "127.0.0.1" in upstream or "localhost" in upstream
    # flush=True is load-bearing: stdout is block-buffered when this is piped to a log,
    # and the child server writes to the same fd unbuffered — so without an explicit
    # flush the child's banner lands first and OUR egress line never appears at all
    # (the parent only flushes at exit, and a server never exits). The one line that
    # tells a user where their tokens are going must not be the line that gets eaten.
    print(f"{ORANGE}⬢ serving genie-1{RESET}  upstream: {upstream}", flush=True)
    print(f"  {'tokens never leave this machine' if private else 'NOT private — tokens go to that cloud'}", flush=True)
    if not private:
        print(f"  {DIM}for a fully private setup: GENIE_UPSTREAM=http://127.0.0.1:11434/v1 "
              f"GENIE_UPSTREAM_MODEL=hermes3:8b genie serve{RESET}", flush=True)
    sys.exit(subprocess.call([sys.executable, "-u", llm] + args, env=env))


def cmd_login(args):
    """Claim a name on the Mesh. This is what makes chain commands work on a fresh install.

    Without a marker, chain.sh answers "Not logged in" to whoami/recall/inscribe — which is the
    first thing a new user tries, so it has to be one obvious command. Onboarding writes the
    marker, generates this node's OWN secret locally, and inscribes a birth block, because
    identity here is established by WORK rather than by a presence ping. Nothing is broadcast;
    nobody can see when you are online.
    """
    if not args:
        die('usage: genie login "<the name you want on the network>"\n'
            "  This is your identity: every skill you contribute and every payout resolves to it.")
    onboard = os.path.join(HERE, "genie_onboard.sh")
    if shutil.which("bash") and os.path.exists(onboard):
        sys.exit(subprocess.call(["bash", onboard] + args))
    # No bash (native Windows). chain.py writes the marker and applies the same two
    # fail-closed guards — OS-login-as-marker and reserved team identities.
    runner = _chain_runner()
    if not runner:
        die("✗ genie_onboard.sh / chain.py are missing next to this script. Run: genie update")
    sys.exit(subprocess.call(runner + ["login"] + args))


def cmd_update():
    """Re-fetch the shared parts. They live in the public plugin repo, so a fix there lands here."""
    # `cli/genie` MUST be in this list. It was not, so every fix to the command itself — the
    # argument parsing, the login path, this updater — was unreachable by anyone who had
    # already installed. They updated, saw ✓ on every line, and kept running the old command.
    # A self-updater that cannot update itself is the one bug that hides all the others.
    files = [("cli/genie", "genie"),
             ("plugins/genie/tools/brain.py", "brain.py"),
             ("plugins/genie/tools/chain.py", "chain.py"),
             ("plugins/genie/tools/chain.sh", "chain.sh"),
             ("plugins/genie/tools/genie_llm.py", "genie_llm.py"),
             ("plugins/genie/tools/genie_onboard.sh", "genie_onboard.sh"),
             ("plugins/genie/skills/wake/canon.md", "canon.md")]
    for remote, local in files:
        dest = os.path.join(HERE, local)
        # Download to a temp path and move into place. Writing straight over `genie` while it
        # is the file being executed is how you end up with a half-written command and a user
        # who cannot even run `genie update` to recover.
        tmp = dest + ".new"
        rc = subprocess.call(["curl", "-fsSL", f"{REPO_RAW}/{remote}", "-o", tmp])
        if rc == 0:
            if local.endswith((".sh",)) or local == "genie":
                os.chmod(tmp, 0o755)
            os.replace(tmp, dest)
        elif os.path.exists(tmp):
            os.remove(tmp)
        print(f"  {'✓' if rc == 0 else '✗'} {local}")
    print("⬢ up to date.")


def cmd_session():
    """Bare `genie` opens a conversation. This is the product: open a terminal, type genie, talk.

    Printing help here was wrong — a new user types the name of the thing they installed and
    expects to be in it, not to be handed a manual. One-shot `genie "question"` still works for
    scripting; this is the interactive door.
    """
    try:
        import brain
    except ImportError:
        die("✗ brain.py is missing next to this script. Run: genie update")

    if not any(brain.available().values()):
        no_brain_help()
        return

    sysmsg = canon()
    print(f"{ORANGE}⬢ Genie{RESET}  {DIM}— ask anything. Ctrl-D or 'exit' to leave.{RESET}\n")
    while True:
        try:
            q = input(f"{ORANGE}›{RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not q:
            continue
        if q.lower() in ("exit", "quit", "bye"):
            return
        txt, info = brain.grounded(sysmsg, q, k=4)
        if txt is None:
            print(f"{DIM}(no brain answered — {info.get('why','unknown')}){RESET}\n")
            continue
        where = {"CLOUD": "left your machine", "PEER": "went to a peer",
                 "NONE": "never left your machine"}
        print(f"\n{txt}\n")
        print(f"{DIM}[{info.get('provider')} · {info.get('model')} · "
              f"{where.get(info.get('egress'),'?')}]{RESET}")
        if info.get("skills"):
            print(f"{DIM}[grounded on: {', '.join(info['skills'])}]{RESET}")
        print()


def main():
    a = sys.argv[1:]
    if a and a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if not a:
        return cmd_session()
    cmd = a[0]
    if cmd == "providers":
        return cmd_providers()
    if cmd == "update":
        return cmd_update()
    if cmd == "serve":
        return cmd_serve(a[1:])
    if cmd in ("recall", "search"):
        return cmd_chain(["search"] + a[1:])
    # Every real chain.sh subcommand, passed straight through. Kept in sync with the case
    # labels in chain.sh — anything NOT in this set is treated as a question, so a missing
    # entry here would silently send a command to the model instead of the chain.
    if cmd == "login":
        return cmd_login(a[1:])
    if cmd in ("skill", "queue", "sync", "mine", "claim", "install",
               "pack", "rate", "collab", "verify", "whoami", "health"):
        return cmd_chain(a)
    # anything else is a question
    cmd_ask(" ".join(a))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
