{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genie 1",
  "version": "0.2.0",
  "identifier": "com.xearn.genie",
  "build": {
    "frontendDist": "../build/web"
  },
  "app": {
    "windows": [
      {
        "title": "Genie 1",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Genie 1",
    "longDescription": "The Genie chat in a native window. Free, no account, no wallet."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "genie1"
        ]
      }
    }
  }
}